# ─────────────────────────────────────────────
# Telemetry Highway — Environment Configuration
# Copy this file to `.env` and adjust as needed.
# ─────────────────────────────────────────────

# ---- Backend / API ----
APP_NAME=Telemetry Highway
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Security. Generate a strong secret:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated CORS origins. Use "*" for dev; set an explicit list in prod,
# e.g. CORS_ORIGINS=https://dashboard.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---- PostgreSQL ----
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry_highway
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://telemetry:telemetry@postgres:5432/telemetry_highway

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
TELEMETRY_STREAM=telemetry:events
TELEMETRY_CONSUMER_GROUP=telemetry-workers
TELEMETRY_DLQ_STREAM=telemetry:dlq

# ---- Ingestion limits ----
MAX_PAYLOAD_BYTES=262144
MAX_BATCH_SIZE=500
RATE_LIMIT_PER_MINUTE=600

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Phase 3: region, retention, notifications, agent ----
DATA_REGION=global
DASHBOARD_BASE_URL=http://localhost:5173

RETENTION_RAW_TELEMETRY_DAYS=7
RETENTION_INCIDENT_DAYS=90
RETENTION_AUDIT_DAYS=365

# SMTP for email notifications (leave blank to disable). No hardcoded secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@telemetry-highway.local
SMTP_USE_TLS=true

AGENT_HEARTBEAT_INTERVAL_SECONDS=30
AGENT_COLLECTION_INTERVAL_SECONDS=15
